{
  "expo": {
    "name": "Kiez Coins",
    "slug": "kiez-coins-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.kiezcoins.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F2123",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "de.kiezcoins.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kiez Coins braucht Zugriff auf Deine Fotos, damit Du ein Foto zur Challenge hinzufügen kannst.",
          "cameraPermission": "Kiez Coins braucht die Kamera, damit Du ein Foto zur Challenge aufnehmen kannst.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kiez Coins nutzt Deinen Standort, um Deinen Kiez zu finden, einen Ort für Deine Challenge vorzuschlagen und Entfernungen im Feed zu zeigen. Dein genauer Standort verlässt Dein Handy nicht."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-localization"
    ],
    "scheme": "kiezcoins",
    "backgroundColor": "#1F2123",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e35cf809-b06f-4797-9ef0-d906e655123e"
      },
      "supportsRTL": true
    },
    "owner": "kiezcoins"
  }
}
