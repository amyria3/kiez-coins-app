{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd .. && npm ci --include=dev",
  "buildCommand": "cd .. && node scripts/build-web-app.mjs",
  "outputDirectory": "dist",
  "ignoreCommand": "bash ../scripts/web-app-bauen.sh",
  "redirects": [
    {
      "source": "/gruppen",
      "destination": "/groups",
      "permanent": true
    },
    {
      "source": "/gruppen/neu",
      "destination": "/groups/new",
      "permanent": true
    },
    {
      "source": "/gruppen/beitreten",
      "destination": "/groups/join",
      "permanent": true
    },
    {
      "source": "/gruppen/:id/aufgabe",
      "destination": "/groups/:id/task",
      "permanent": true
    },
    {
      "source": "/gruppen/:id",
      "destination": "/groups/:id",
      "permanent": true
    },
    {
      "source": "/freunde/einladen",
      "destination": "/friends/invite",
      "permanent": true
    },
    {
      "source": "/reise",
      "destination": "/me",
      "permanent": true
    },
    {
      "source": "/kater",
      "destination": "/cat",
      "permanent": true
    },
    {
      "source": "/texte",
      "destination": "/texts",
      "permanent": true
    },
    {
      "source": "/rechtliches/:doc",
      "destination": "/legal/:doc",
      "permanent": true
    },
    {
      "source": "/vorher-nachher/:id",
      "destination": "/before-after/:id",
      "permanent": true
    },
    {
      "source": "/settings/:page",
      "destination": "/account/:page",
      "permanent": true
    },
    {
      "source": "/account/datenabrufe",
      "destination": "/account/data-access",
      "permanent": true
    },
    {
      "source": "/account/freunde",
      "destination": "/account/friends",
      "permanent": true
    },
    {
      "source": "/account/funktionen",
      "destination": "/account/features",
      "permanent": true
    },
    {
      "source": "/account/geschlecht",
      "destination": "/account/gender",
      "permanent": true
    },
    {
      "source": "/account/sprache",
      "destination": "/account/language",
      "permanent": true
    },
    {
      "source": "/account/umfrage/ergebnis",
      "destination": "/account/survey/results",
      "permanent": true
    },
    {
      "source": "/onboarding/deckname",
      "destination": "/onboarding/handle",
      "permanent": true
    },
    {
      "source": "/onboarding/funktionen",
      "destination": "/onboarding/features",
      "permanent": true
    },
    {
      "source": "/onboarding/kodex",
      "destination": "/onboarding/code-of-conduct",
      "permanent": true
    },
    {
      "source": "/onboarding/ohne-mail",
      "destination": "/onboarding/no-email",
      "permanent": true
    },
    {
      "source": "/challenge/:id/flag",
      "destination": "/challenge/:id/report",
      "permanent": true
    },
    {
      "source": "/challenge/:id/flag/success",
      "destination": "/challenge/:id/report/success",
      "permanent": true
    },
    {
      "source": "/challenge/:id/payment",
      "destination": "/challenge/:id/received",
      "permanent": true
    },
    {
      "source": "/challenge/:id/payment/success",
      "destination": "/challenge/:id/received/success",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!_expo/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://aqxzxpxrshizlaqyjplw.supabase.co; media-src 'self' data: blob: https://aqxzxpxrshizlaqyjplw.supabase.co; font-src 'self' data:; connect-src 'self' data: blob: https://aqxzxpxrshizlaqyjplw.supabase.co wss://aqxzxpxrshizlaqyjplw.supabase.co https://nominatim.openstreetmap.org; frame-src https://kiezcoins.de; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
