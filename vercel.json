{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  },
  "buildCommand": "node scripts/build-download-site.mjs",
  "ignoreCommand": "bash scripts/website-bauen.sh",
  "outputDirectory": "website",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/((?!app-uebergabe).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/app-uebergabe(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; frame-ancestors https://app.kiezcoins.de"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app/:path+",
      "destination": "https://app.kiezcoins.de/:path*",
      "permanent": false
    },
    {
      "source": "/schaufenster",
      "destination": "https://app.kiezcoins.de/schaufenster",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app-umzug"
    },
    {
      "source": "/app/",
      "destination": "/app-umzug"
    },
    {
      "source": "/einladung/:code",
      "destination": "/einladung"
    },
    {
      "source": "/c/:id",
      "destination": "/api/c?id=:id"
    },
    {
      "source": "/s/:slug/termine.ics",
      "destination": "/api/s?slug=:slug&format=ics"
    },
    {
      "source": "/s/:slug/visitenkarte",
      "destination": "/api/s?slug=:slug&ansicht=visitenkarte"
    },
    {
      "source": "/s/:slug/visitenkarte.png",
      "destination": "/api/s?slug=:slug&format=png"
    },
    {
      "source": "/s/:slug/karte.png",
      "destination": "/api/s?slug=:slug&format=karte"
    },
    {
      "source": "/s/:slug/kontakt.vcf",
      "destination": "/api/s?slug=:slug&format=vcf"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/s?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}
