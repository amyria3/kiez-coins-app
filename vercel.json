{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:website",
  "outputDirectory": "website",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/einladung/:code",
      "destination": "/einladung.html"
    }
  ]
}
